# camera drivers load service
service camera_init_sh /vendor/bin/init.insmod.sh /vendor/etc/camera.init.cfg
    class main
    user root
    group root system
    disabled
    oneshot

# start camera drivers load service
on property:vendor.vehicle.register=1
    start camera_init_sh

# restart camera provider
on property:sys.boot_completed=1 && property:vendor.vehicle.register=1
    stop vendor.camera-provider-2-7-google
    start vendor.camera-provider-2-7-google

# register android
on property:service.sf.present_timestamp=1
    # register the vehicle_rpmsg_m4 on raw android.
    write /sys/devices/platform/vehicle_rpmsg_m4/register 1
    # register the vehicle_rpmsg_m4 on android running in xen.
    write /sys/devices/platform/passthrough/passthrough\:vehicle_rpmsg_m4/register 1
